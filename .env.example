# 环境变量模板：复制为 .env.dev / .env.prod / .env.test 并填入真实值
# cp .env.example .env.dev    （开发）
# cp .env.example .env.prod   （生产）
# cp .env.example .env.test   （测试）

# 当前环境（dev / prod / test）
APP_ENV=dev

# 安全密钥（生产务必用随机长字符串！`python -c "import secrets; print(secrets.token_hex(32))"`）
SECRET_KEY=change-me-to-a-random-secret

# 数据库
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=library
DB_PASSWORD=library123
DB_NAME=library

# 种子管理员
SEED_USERNAME=admin
SEED_PASSWORD=admin123

# Docker 基础镜像（compose 读取项目根目录的 `.env`，不是 `.env.dev`）
# 国内默认已写在 docker-compose.yml 里；能直连 Docker Hub 时可改成官方名
# POSTGRES_IMAGE=postgres:16
# PYTHON_IMAGE=python:3.12-slim
# NGINX_IMAGE=nginx:alpine
